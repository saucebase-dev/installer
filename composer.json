{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "saucebase/installer",
  "description": "The Saucebase application installer.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "composer-runtime-api": "^2.2",
    "guzzlehttp/guzzle": "^8.3",
    "illuminate/console": "^13.38",
    "illuminate/container": "^13.38",
    "illuminate/events": "^13.38",
    "illuminate/filesystem": "^13.38",
    "illuminate/http": "^13.38",
    "illuminate/support": "^13.38",
    "laravel/installer": "^5.32",
    "laravel/prompts": "^0.3.26",
    "symfony/process": "^8.1.9",
    "illuminate/process": "^13.38"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4.3",
    "mockery/mockery": "^1.6.15"
  },
  "autoload": {
    "psr-4": {
      "Saucebase\\Installer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Saucebase\\Installer\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/saucebase"
  ],
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
